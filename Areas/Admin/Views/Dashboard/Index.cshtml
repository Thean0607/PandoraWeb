@model IEnumerable<PandoraWeb.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string FormatCurrency(decimal? value) {
        return (value ?? 0).ToString("N0") + " ₫";
    }
}

<h1 class="page-title">Tổng Quan Thống Kê</h1>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="admin-card">
            <div class="stat-card">
                <div class="stat-info">
                    <h3>Tổng Doanh Thu</h3>
                    <p class="stat-value" id="statRevenue">@FormatCurrency(ViewBag.TotalRevenue)</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-wallet"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="admin-card">
            <div class="stat-card">
                <div class="stat-info">
                    <h3>Sản Phẩm</h3>
                    <p class="stat-value" id="statProducts">@ViewBag.TotalProducts</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-box"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="admin-card">
            <div class="stat-card">
                <div class="stat-info">
                    <h3>Khách Hàng</h3>
                    <p class="stat-value" id="statCustomers">@ViewBag.TotalCustomers</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="admin-card">
            <div class="stat-card">
                <div class="stat-info">
                    <h3>Đơn Hàng Mới</h3>
                    <p class="stat-value">@ViewBag.TotalNewOrders</p>
                </div>
                <div class="stat-icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <h4 class="mb-4">Đơn hàng gần đây</h4>
            <div class="table-responsive table-wrapper">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Khách Hàng</th>
                            <th>Tổng Tiền</th>
                            <th>Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model != null && Model.Any()) {
                            foreach(var order in Model) {
                                <tr>
                                    <td>#ORD-@order.OrderId</td>
                                    <td>@(order.Customer != null ? order.Customer.FullName : "Khách Lẻ")</td>
                                    <td>@FormatCurrency(order.TotalAmount)</td>
                                    <td>
                                        @if(order.OrderStatus == "Pending") { <span class="status-badge status-warning">Chờ Xử Lý</span> }
                                        else if (order.OrderStatus == "Processing") { <span class="status-badge status-warning">Đang Xử Lý</span> }
                                        else if (order.OrderStatus == "Shipped") { <span class="status-badge status-active">Đang Giao</span> }
                                        else if (order.OrderStatus == "Completed") { <span class="status-badge status-active">Hoàn Thành</span> }
                                        else if (order.OrderStatus == "Cancelled" || order.OrderStatus == "Refunded") { <span class="status-badge status-inactive">Đã Hủy</span> }
                                        else { <span class="status-badge status-inactive">@order.OrderStatus</span> }
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="4" class="text-center text-muted">Chưa có đơn hàng nào</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card">
            <h4 class="mb-4">Hoạt động gần đây</h4>
            <ul class="list-unstyled">
                <li class="mb-3 border-bottom pb-3">
                    <p class="mb-1"><i class="fas fa-info-circle text-info me-2"></i>Tính năng lịch sử đang được phát triển</p>
                    <small class="text-muted">Vừa xong</small>
                </li>
            </ul>
        </div>
    </div>
</div>



@model PandoraWeb.Models.Collection
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.CollectionName;
}

<!-- Collection Header -->
<div class="breadcrumb-wrap mt-5 pt-5 pb-5 bg-light" style="background: url('@PandoraWeb.Helpers.ImageHelper.GetImageUrl(Model.ImageUrl, "https://images.unsplash.com/photo-1605100804763-247f67b6348e?q=80&w=1200")') center/cover no-repeat; position: relative;">
    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
    <div class="container mt-4 position-relative z-1 text-center text-white">
        <a href="javascript:history.back()" class="position-absolute top-0 start-0 text-white text-decoration-none mt-2 opacity-75 hover-opacity-100 transition" title="Quay lại trang trước">
            <i class="fas fa-arrow-left fs-4"></i>
        </a>
        <h1 class="breadcrumb-title font-serif text-white">Bộ Sưu Tập: @Model.CollectionName</h1>
        @if(!string.IsNullOrEmpty(Model.Description)){
            <p class="lead mt-3 mx-auto" style="max-width: 800px;">@Model.Description</p>
        }
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mt-3">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-white">Trang Chủ</a></li>
                <li class="breadcrumb-item active text-white-50" aria-current="page">@Model.CollectionName</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Product Content -->
<section class="py-5">
    <div class="container">
        @using (Html.BeginForm("CollectionDetail", "Product", FormMethod.Get, new { id = "filterForm" }))
        {
            <input type="hidden" name="id" value="@Model.CollectionId" />
            <div class="row">
                <!-- Product Grid (Full Width) -->
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <p class="mb-0 text-muted">Hiển thị @Model.Products.Count() sản phẩm trong bộ sưu tập</p>
                        <select class="form-select w-auto border-0 bg-light" name="sort" onchange="document.getElementById('filterForm').submit();">
                            <option value="newest" @(ViewBag.Sort == "newest" ? "selected" : "")>Mới nhất</option>
                            <option value="price_asc" @(ViewBag.Sort == "price_asc" ? "selected" : "")>Giá: Thấp đến Cao</option>
                            <option value="price_desc" @(ViewBag.Sort == "price_desc" ? "selected" : "")>Giá: Cao xuống Thấp</option>
                        </select>
                    </div>

                    <div class="row">
                        @if (Model.Products != null && Model.Products.Any())
                        {
                            foreach (var item in Model.Products)
                            {
                                <!-- Product Item -->
                                <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                                    <div class="product-card">
                                        <div class="product-img-wrapper">
                                            <a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })">
                                                <img src="@PandoraWeb.Helpers.ImageHelper.GetImageUrl(item.ImageUrl, "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?q=80&w=600")" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?q=80&w=600'" alt="@item.ProductName">
                                            </a>
                                            <div class="product-action">
                                                <a href="javascript:void(0);" class="action-btn btn-add-cart" data-pid="@item.ProductId" title="Thêm vào giỏ hàng"><i class="fas fa-shopping-cart"></i></a>
                                                <a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })" class="action-btn" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                                <a href="javascript:void(0);" class="action-btn btn-wishlist" data-pid="@item.ProductId" title="Yêu thích"><i class="far fa-heart"></i></a>
                                            </div>
                                        </div>
                                        <div class="product-info">
                                            <div class="product-category">@(item.Category != null ? item.Category.CategoryName : "")</div>
                                            <h3 class="product-title"><a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })">@item.ProductName</a></h3>
                                            <div class="product-price">@item.BasePrice.ToString("N0") ₫</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-5">
                                <p class="text-muted">Chưa có sản phẩm nào trong bộ sưu tập này.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

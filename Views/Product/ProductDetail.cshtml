@model PandoraWeb.Models.Product
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model != null ? Model.ProductName : "Chi Tiết Sản Phẩm";
}

<!-- Breadcrumb -->
<div class="container mt-5 pt-5 pb-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mt-4">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Category", "Product")">Sản Phẩm</a></li>
            <li class="breadcrumb-item"><a href="#">@(Model.Category != null ? Model.Category.CategoryName : "")</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
        </ol>
    </nav>
</div>

<!-- Product Details -->
<section class="py-4">
    <div class="container">
        <div class="row">
            <!-- Product Images -->
            <div class="col-md-6 mb-4 mb-md-0">
                <div class="card border-0">
                    <img src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : Url.Content("~/" + Model.ImageUrl)) : "https://images.unsplash.com/photo-1605100804763-247f67b2548e?q=80&w=600")" class="w-100 img-fluid rounded" alt="@Model.ProductName" id="mainImage">
                </div>
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="row mt-3 g-2">
                        <div class="col-3">
                            <img src="@(!string.IsNullOrEmpty(Model.ImageUrl) ? (Model.ImageUrl.StartsWith("http") ? Model.ImageUrl : Url.Content("~/" + Model.ImageUrl)) : "https://images.unsplash.com/photo-1605100804763-247f67b2548e?q=80&w=600")" class="w-100 rounded border border-1 p-1 cursor-pointer" alt="Thumb" onclick="document.getElementById('mainImage').src=this.src">
                        </div>
                        @foreach (var img in Model.ProductImages)
                        {
                            var subUrl = img.ImageUrl != null && img.ImageUrl.StartsWith("http") ? img.ImageUrl : Url.Content("~/" + img.ImageUrl);
                            <div class="col-3">
                                <img src="@subUrl" class="w-100 rounded border border-1 p-1 cursor-pointer" alt="Thumb" onclick="document.getElementById('mainImage').src=this.src">
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Product Info -->
            <div class="col-md-6 ps-md-5">
                <div class="text-uppercase text-muted fs-7 mb-2 tracking-wide">@(Model.Category != null ? Model.Category.CategoryName : "")</div>
                <h1 class="font-serif display-5 mb-3">@Model.ProductName</h1>
                <div class="d-flex align-items-center mb-4">
                    <div class="text-warning me-2">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="text-muted fs-7">(24 đánh giá)</span>
                </div>
                <h2 class="text-primary-gold fw-bold mb-4">@Model.BasePrice.ToString("N0") ₫</h2>
                
                @{
                    var totalStock = Model.ProductVariants != null && Model.ProductVariants.Any() ? Model.ProductVariants.Sum(v => v.Stock) : 10;
                }
                <p class="text-muted mb-4">Tình trạng: 
                    @if(totalStock > 0){
                        <span class="text-success fw-bold">Còn hàng (@totalStock)</span>
                    } else {
                        <span class="text-danger fw-bold">Hết hàng</span>
                    }
                </p>
                
                <hr>

                <!-- Size / Variant Selection -->
                @if (Model.ProductVariants != null && Model.ProductVariants.Any(v => v.Size != null || v.Material != null))
                {
                    <div class="mb-4">
                        <h6 class="mb-3 fw-bold">Chọn Kích Cỡ / Biến Thể:</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @{ int vIdx = 0; }
                            @foreach (var variant in Model.ProductVariants)
                            {
                                string labelText = variant.Size != null ? variant.Size.SizeValue : (variant.Material != null ? variant.Material.MaterialName : "Standard");
                                <input type="radio" class="btn-check" name="variantId" id="variant_@variant.VariantId" value="@variant.VariantId" autocomplete="off" @(vIdx == 0 ? "checked" : "")>
                                <label class="btn btn-outline-dark rounded-pill px-3 py-2 d-flex align-items-center justify-content-center" for="variant_@variant.VariantId">@labelText</label>
                                vIdx++;
                            }
                        </div>
                    </div>
                }

                <!-- Quantity & Add to Cart -->
                <div class="d-flex align-items-center mb-4 gap-3">
                    <div class="quantity-input input-group" style="width: 130px;">
                        <button class="btn btn-minus" type="button"><i class="fas fa-minus"></i></button>
                        <input type="text" class="form-control quantity-val" value="1" id="productQuantity">
                        <button class="btn btn-plus" type="button"><i class="fas fa-plus"></i></button>
                    </div>
                    <button class="btn btn-gold flex-grow-1 py-3 btn-add-cart" data-pid="@Model.ProductId"><i class="fas fa-shopping-bag me-2"></i>Thêm Vào Giỏ Hàng</button>
                    <button class="btn btn-dark flex-grow-1 py-3 btn-buy-now" data-pid="@Model.ProductId"><i class="fas fa-bolt me-2"></i>Mua Ngay</button>
                    <button class="btn btn-outline-dark py-3 px-4 btn-wishlist" data-pid="@Model.ProductId"><i class="far fa-heart"></i></button>
                </div>

                <!-- Extra Info -->
                <ul class="list-unstyled text-muted fs-7 mt-4">
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Miễn phí vận chuyển toàn quốc</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Bảo hành trọn đời</li>
                    <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Đổi trả trong 15 ngày</li>
                </ul>

            </div>
        </div>
    </div>
</section>

<!-- Detailed Tabs -->
<section class="py-5 border-top">
    <div class="container">
        <ul class="nav nav-tabs justify-content-center mb-4" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active text-dark fw-bold" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">Mô Tả Sản Phẩm</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link text-dark fw-bold" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">Thông Tin Chi Tiết</button>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active text-center w-75 mx-auto text-muted" id="desc" role="tabpanel">
                <p>@(!string.IsNullOrEmpty(Model.Description) ? Model.Description : "Mỗi chi tiết trên sản phẩm đều được chế tác thủ công bởi những nghệ nhân lành nghề nhất.")</p>
            </div>
            <div class="tab-pane fade text-center w-50 mx-auto text-muted" id="info" role="tabpanel">
                <ul class="list-group list-group-flush text-start">
                    <li class="list-group-item d-flex justify-content-between"><span>Danh mục:</span> <strong>@(Model.Category != null ? Model.Category.CategoryName : "")</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Bảo hành:</span> <strong>Trọn đời</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Xuất xứ:</span> <strong>Chính hãng Pandora</strong></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buyNowBtn = document.querySelector('.btn-buy-now');
            if(buyNowBtn) {
                buyNowBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const pid = this.getAttribute('data-pid');
                    const qtyInput = document.getElementById('productQuantity');
                    const quantity = qtyInput ? qtyInput.value : 1;
                    const selectedVariantRadio = document.querySelector('input[name="variantId"]:checked');
                    const variantId = selectedVariantRadio ? selectedVariantRadio.value : '';
                    
                    let bodyData = `productId=${pid}&quantity=${quantity}`;
                    if (variantId) bodyData += `&variantId=${variantId}`;

                    fetch('@Url.Action("AddToCart", "Order")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: bodyData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            window.location.href = '@Url.Action("Checkout", "Order")';
                        } else {
                            alert(data.message || 'Có lỗi xảy ra');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                    });
                });
            }
        });
    </script>
}

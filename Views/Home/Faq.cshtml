@model IEnumerable<PandoraWeb.Models.Faq>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Faq";
}

<!-- Page Header -->
    <div class="container faq-header">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted">Trang Chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Câu Hỏi Thường Gặp</li>
            </ol>
        </nav>
        <h1 class="faq-title">Câu Hỏi Thường Gặp (FAQ)</h1>
        <p class="text-muted max-w-600 mx-auto">Tìm kiếm câu trả lời nhanh cho các vấn đề về mua sắm, giao hàng, bảo hành và dịch vụ hậu mãi của Pandora.</p>
    </div>

    <!-- FAQ Content -->
    <div class="container mb-5 pb-5">
        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-3">
                <div class="faq-sidebar">
                    <h5 class="font-serif mb-4">Danh Mục</h5>
                    <a href="#all" class="faq-nav-link active">Tất cả câu hỏi</a>
                </div>
            </div>

            <!-- FAQ Accordions -->
            <div class="col-lg-9 mt-4 mt-lg-0">
                <div id="all" class="mb-5 pt-4">
                    <h2 class="faq-section-title">Danh Sách Câu Hỏi</h2>
                    <div class="accordion faq-accordion" id="accordionAll">
                        @if (Model != null && Model.Any())
                        {
                            int i = 0;
                            foreach (var item in Model)
                            {
                                i++;
                                <div class="accordion-item">
                                    <h2 class="accordion-header">
                                        <button class="accordion-button @(i == 1 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#faq_@item.FaqId">
                                            @item.Question
                                        </button>
                                    </h2>
                                    <div id="faq_@item.FaqId" class="accordion-collapse collapse @(i == 1 ? "show" : "")" data-bs-parent="#accordionAll">
                                        <div class="accordion-body">
                                            @Html.Raw(item.Answer)
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">Đang cập nhật danh sách câu hỏi...</p>
                        }
                    </div>
                </div>

                <!-- Contact Support Box -->
                <div class="contact-support-box">
                    <h3 class="font-serif mb-3">Bạn Vẫn Còn Thắc Mắc?</h3>
                    <p class="text-muted mb-4">Đội ngũ chăm sóc khách hàng của chúng tôi luôn sẵn sàng hỗ trợ bạn giải đáp mọi vấn đề nhanh chóng nhất.</p>
                    <a href="@Url.Action("Contact", "Home")" class="btn btn-gold px-5 py-3">Liên Hệ Ngay</a>
                </div>

            </div>
        </div>
    </div>

    <!-- Footer -->


@model PandoraWeb.ViewModels.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang Chủ";
}

<style>
    .trending-carousel::-webkit-scrollbar {
        display: none;
    }
    .trending-carousel {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

    <!-- Global Search Bar (Above Banner) -->
    <div class="container mb-4 mt-5 pt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form class="d-flex align-items-center position-relative w-100" action="@Url.Action("Category", "Product")" method="get">
                    <div class="input-group input-group-lg shadow-sm border rounded-pill overflow-hidden bg-white">
                        <input type="text" id="searchInput" class="form-control border-0 px-4" name="search" placeholder="Tìm kiếm trang sức, bộ sưu tập..." aria-label="Search" style="box-shadow: none;" autocomplete="off">
                        <button class="btn btn-gold px-4 text-dark fw-bold border-0" type="submit">
                            <i class="fas fa-search me-2"></i> Tìm kiếm
                        </button>
                    </div>
                    <div id="searchSuggestions" class="dropdown-menu w-100 mt-2 shadow-lg border-0 rounded-4 overflow-hidden" style="display: none; position: absolute; top: 100%; left: 0; max-height: 400px; overflow-y: auto; z-index: 1050;">
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Hero Section Carousel -->
    <div class="container mb-5">
        <div id="heroCarousel" class="carousel slide rounded-4 overflow-hidden" data-bs-ride="carousel" data-bs-interval="5000" style="box-shadow: 0 10px 30px rgba(0,0,0,0.1);">

            @if(Model.Banners != null && Model.Banners.Any())
            {
                <div class="carousel-indicators">
                    @for(int i = 0; i < Model.Banners.Count(); i++)
                    {
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @{ int j = 0; }
                    @foreach (var banner in Model.Banners)
                    {
                        var imgUrl = PandoraWeb.Helpers.ImageHelper.GetImageUrl(banner.ImageUrl, "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=2000&auto=format&fit=crop");
                        <div class="carousel-item @(j == 0 ? "active" : "")" data-bs-interval="5000">
                            <div class="hero-section w-100 h-100">
                                <img src="@imgUrl" alt="@banner.Title" class="hero-img">
                                <div class="container-fluid h-100 d-flex align-items-center position-relative z-3">
                                    <div class="hero-content mx-3 mx-md-5">
                                        <h1 class="hero-title">@banner.Title</h1>
                                        <p class="hero-subtitle">Khám phá bộ sưu tập mới nhất với các thiết kế tinh xảo.</p>
                                        <a href="@(string.IsNullOrEmpty(banner.LinkUrl) ? Url.Action("Category", "Product") : banner.LinkUrl)" class="btn btn-gold">Mua Ngay</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        j++;
                    }
                </div>
            }
            else
            {
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                </div>
                <div class="carousel-inner">
                    <!-- Slide 1 -->
                    <div class="carousel-item active" data-bs-interval="5000">
                        <div class="hero-section w-100 h-100">
                            <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=2000&auto=format&fit=crop" alt="Hero Banner 1" class="hero-img">
                            <div class="container-fluid h-100 d-flex align-items-center position-relative z-3">
                                <div class="hero-content mx-3 mx-md-5">
                                    <h1 class="hero-title">Elegance in Every Detail</h1>
                                    <p class="hero-subtitle">Khám phá bộ sưu tập mùa xuân mới nhất với các thiết kế tinh xảo, tôn vinh vẻ đẹp vĩnh cửu.</p>
                                    <a href="@Url.Action("Category", "Product")" class="btn btn-gold">Mua Ngay</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 2 -->
                    <div class="carousel-item" data-bs-interval="5000">
                        <div class="hero-section w-100 h-100">
                            <img src="https://images.unsplash.com/photo-1599643478514-4a4e02632616?q=80&w=2000&auto=format&fit=crop" alt="Hero Banner 2" class="hero-img">
                            <div class="container-fluid h-100 d-flex align-items-center position-relative z-3">
                                <div class="hero-content mx-3 mx-md-5">
                                    <h1 class="hero-title">Timeless Classics</h1>
                                    <p class="hero-subtitle">Mỗi món trang sức là một câu chuyện tình yêu. Hãy để chúng tôi kể câu chuyện của bạn.</p>
                                    <a href="@Url.Action("Category", "Product")" class="btn btn-gold">Khám Phá Thêm</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="z-index: 4;">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="z-index: 4;">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>

    <!-- Flash Sale -->
    <section class="py-5" style="background-color: #fffaf0;">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="mb-0 text-danger font-serif fw-bold"><i class="fas fa-bolt me-2"></i>Flash Sale / Khuyến Mãi</h2>
                <a href="@Url.Action("Category", "Product")" class="text-danger text-decoration-none">Xem tất cả <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
            <div class="row">
            @if(Model.FlashSaleProducts != null && Model.FlashSaleProducts.Any())
            {
                foreach (var item in Model.FlashSaleProducts)
                {
                    var imgUrl = item.ImageUrl != null && item.ImageUrl.StartsWith("http") ? item.ImageUrl : Url.Content("~/" + item.ImageUrl);
                    <div class="col-lg-3 col-md-4 col-sm-6 col-6">
                        <div class="product-card border border-danger-subtle shadow-sm position-relative">
                            <div class="position-absolute top-0 start-0 m-2 z-1">
                                <span class="badge bg-danger rounded-pill px-2 py-1">-@(item.OldPrice.HasValue && item.OldPrice.Value > 0 ? Math.Round((item.OldPrice.Value - item.BasePrice) / item.OldPrice.Value * 100) : 0)%</span>
                            </div>
                            <div class="product-img-wrapper">
                                <img src="@imgUrl" onerror="this.src='https://images.unsplash.com/photo-1605100804763-247f67b2548e?q=80&w=600'" alt="@item.ProductName">
                                <div class="product-action">
                                    <a href="javascript:void(0);" class="action-btn btn-add-cart" data-pid="@item.ProductId" data-bs-toggle="tooltip" title="Thêm vào giỏ hàng"><i class="fas fa-shopping-cart"></i></a>
                                    <a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })" class="action-btn" data-bs-toggle="tooltip" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                </div>
                            </div>
                            <div class="product-info bg-white">
                                <div class="product-category text-danger fw-bold">Khuyến Mãi Hot</div>
                                <h3 class="product-title"><a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })">@item.ProductName</a></h3>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div class="product-price text-danger fs-5">@item.BasePrice.ToString("N0") ₫</div>
                                    <div class="text-muted text-decoration-line-through small">@item.OldPrice.Value.ToString("N0") ₫</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">Hiện chưa có chương trình khuyến mãi nào.</p>
                </div>
            }
            </div>
        </div>
    </section>

    <!-- Featured Categories -->
    <section class="py-5 mt-5">
        <div class="container">
            <div class="section-title">
                <h2>Bộ Sưu Tập Nổi Bật</h2>
                <div class="title-separator"></div>
            </div>
            <div class="row g-4 justify-content-center">
            @if(Model.Collections != null && Model.Collections.Any())
            {
                foreach (var item in Model.Collections)
                {
                    var imgUrl = item.ImageUrl != null && item.ImageUrl.StartsWith("http") ? item.ImageUrl : Url.Content("~/" + item.ImageUrl);
                    <div class="col-md-4 col-sm-6">
                        <div class="position-relative overflow-hidden group-hover rounded" style="height: 280px;">
                            <img src="@imgUrl" class="w-100 h-100 object-fit-cover transition" alt="@item.CollectionName" onerror="this.src='https://images.unsplash.com/photo-1605100804763-247f67b6348e?q=80&w=600'">
                            <div class="position-absolute bottom-0 start-0 w-100 p-4 bg-gradient-dark">
                                <h3 class="text-white mb-0 font-serif fs-4">@item.CollectionName</h3>
                                <a href="@Url.Action("CollectionDetail", "Product", new { id = item.CollectionId })" class="text-white text-decoration-none small">Khám phá <i class="fas fa-arrow-right ms-2"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Chưa có bộ sưu tập nào. Hãy thêm trong trang quản trị.</p>
                </div>
            }
            </div>
        </div>
    </section>

    <!-- Trending Products -->
    <section class="py-5 bg-secondary-soft">
        <div class="container">
            <div class="section-title">
                <h2>Sản Phẩm Bán Chạy</h2>
                <div class="title-separator"></div>
            </div>
            <div class="position-relative px-2">
                <button id="btnTrendingPrev" class="btn btn-gold shadow position-absolute top-50 start-0 translate-middle-y z-3 rounded-circle" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; left: -10px !important;"><i class="fas fa-chevron-left"></i></button>
                <div class="row flex-nowrap overflow-auto trending-carousel py-3" id="trendingCarousel" style="scroll-behavior: smooth;">
                @if(Model.TrendingProducts != null && Model.TrendingProducts.Any())
                {
                    foreach (var item in Model.TrendingProducts)
                    {
                        var imgUrl = item.ImageUrl != null && item.ImageUrl.StartsWith("http") ? item.ImageUrl : Url.Content("~/" + item.ImageUrl);
                        <div class="col-lg-2 col-md-3 col-sm-4 col-6">
                            <div class="product-card">
                                <div class="product-img-wrapper">
                                    <img src="@imgUrl" onerror="this.src='https://images.unsplash.com/photo-1605100804763-247f67b2548e?q=80&w=600'" alt="@item.ProductName">
                                    <div class="product-action">
                                        <a href="javascript:void(0);" class="action-btn btn-add-cart" data-pid="@item.ProductId" data-bs-toggle="tooltip" title="Thêm vào giỏ hàng"><i class="fas fa-shopping-cart"></i></a>
                                        <a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })" class="action-btn" data-bs-toggle="tooltip" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                        <a href="javascript:void(0);" class="action-btn btn-wishlist" data-pid="@item.ProductId" data-bs-toggle="tooltip" title="Yêu thích"><i class="far fa-heart"></i></a>
                                    </div>
                                </div>
                                <div class="product-info">
                                    <div class="product-category">@(item.Category != null ? item.Category.CategoryName : "")</div>
                                    <h3 class="product-title"><a href="@Url.Action("ProductDetail", "Product", new { id = item.ProductId })">@item.ProductName</a></h3>
                                    <div class="product-price">@item.BasePrice.ToString("N0") ₫</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 w-100">
                        <p class="text-muted">Chưa có sản phẩm nào được hiển thị.</p>
                    </div>
                }
                </div>
                <button id="btnTrendingNext" class="btn btn-gold shadow position-absolute top-50 end-0 translate-middle-y z-3 rounded-circle" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; right: -10px !important;"><i class="fas fa-chevron-right"></i></button>
            </div>
            <div class="text-center mt-4">
                <a href="@Url.Action("Category", "Product")" class="btn btn-outline-gold">Xem Tất Cả Sản Phẩm</a>
            </div>
        </div>
    </section>

    <!-- Latest Blog Posts -->
    <section class="py-5">
        <div class="container">
            <div class="section-title">
                <h2>Tin Tức Mới Nhất</h2>
                <div class="title-separator"></div>
            </div>
            <div class="row">
            @if(Model.LatestBlogs != null && Model.LatestBlogs.Any())
            {
                foreach (var post in Model.LatestBlogs)
                {
                    <div class="col-md-4 mb-4 mb-md-0">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden group-hover">
                            <a href="@Url.Action("BlogDetail", "Home", new { id = post.PostId })" class="overflow-hidden d-block" style="height: 200px;">
                                <img src="@PandoraWeb.Helpers.ImageHelper.GetImageUrl(post.ImageUrl, "https://images.unsplash.com/photo-1512413914436-1c2552886f7f?q=80&w=600")" class="w-100 h-100 object-fit-cover transition-scale" alt="@post.Title" onerror="this.src='https://images.unsplash.com/photo-1512413914436-1c2552886f7f?q=80&w=600'">
                            </a>
                            <div class="card-body p-4">
                                <div class="text-muted small mb-2"><i class="far fa-calendar-alt me-1 text-primary-gold"></i> @post.PublishedDate.ToString("dd/MM/yyyy")</div>
                                <h4 class="card-title font-serif fs-5 mb-3">
                                    <a href="@Url.Action("BlogDetail", "Home", new { id = post.PostId })" class="text-dark text-decoration-none">@post.Title</a>
                                </h4>
                                <a href="@Url.Action("BlogDetail", "Home", new { id = post.PostId })" class="text-primary-gold text-decoration-none fw-medium small text-uppercase tracking-wider">Đọc Thêm <i class="fas fa-arrow-right ms-1"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">Chưa có bài viết mới.</p>
                </div>
            }
            </div>
            <div class="text-center mt-5">
                <a href="@Url.Action("Blog", "Home")" class="btn btn-outline-dark rounded-pill px-4">Xem Tất Cả Tin Tức</a>
            </div>
        </div>
    </section>

    <!-- Feature Highlights -->
    <section class="py-5">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4 mb-md-0">
                    <i class="fas fa-shipping-fast text-primary-gold fs-1 mb-3"></i>
                    <h4 class="font-serif">Miễn Phí Vận Chuyển</h4>
                    <p class="text-muted">Cho mọi đơn hàng trên 2,000,000 ₫</p>
                </div>
                <div class="col-md-4 mb-4 mb-md-0">
                    <i class="fas fa-sync-alt text-primary-gold fs-1 mb-3"></i>
                    <h4 class="font-serif">Đổi Trả Dễ Dàng</h4>
                    <p class="text-muted">Trong vòng 15 ngày kể từ ngày mua</p>
                </div>
                <div class="col-md-4">
                    <i class="fas fa-gem text-primary-gold fs-1 mb-3"></i>
                    <h4 class="font-serif">Bảo Hành Trọn Đời</h4>
                    <p class="text-muted">Dịch vụ làm sạch và đánh bóng miễn phí</p>
                </div>
            </div>
        </div>
    </section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var heroCarouselEl = document.getElementById('heroCarousel');
            if (heroCarouselEl) {
                var carouselInstance = bootstrap.Carousel.getInstance(heroCarouselEl);
                if (!carouselInstance) {
                    carouselInstance = new bootstrap.Carousel(heroCarouselEl, {
                        interval: 5000,
                        touch: true,
                        pause: 'hover'
                    });
                }
                carouselInstance.cycle();
            }

            // Trending Carousel
            const trendingCarousel = document.getElementById('trendingCarousel');
            const btnTrendingPrev = document.getElementById('btnTrendingPrev');
            const btnTrendingNext = document.getElementById('btnTrendingNext');

            if (trendingCarousel && btnTrendingPrev && btnTrendingNext) {
                btnTrendingNext.addEventListener('click', function() {
                    const scrollAmount = trendingCarousel.offsetWidth * 0.8;
                    trendingCarousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
                
                btnTrendingPrev.addEventListener('click', function() {
                    const scrollAmount = trendingCarousel.offsetWidth * 0.8;
                    trendingCarousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                });
            }
        });
    </script>
}

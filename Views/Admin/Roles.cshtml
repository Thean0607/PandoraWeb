@model IEnumerable<PandoraWeb.Models.Data.Role>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .permission-checkboxes {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 10px;
        }
        .permission-item {
            background-color: rgba(0,0,0,0.2);
            padding: 10px;
            border-radius: 6px;
            border: 1px solid var(--admin-border);
        }
        .form-check-input:checked {
            background-color: var(--admin-accent);
            border-color: var(--admin-accent);
        }
    </style>
}

<div class="page-title">
    Phân Quyền Quản Lý
    <button class="btn btn-admin" onclick="openRoleModal()">
        <i class="fas fa-plus"></i> Thêm Nhóm Quyền
    </button>
</div>

<div class="admin-card">
    <div class="table-responsive table-wrapper">
        <table class="table admin-table" id="roleTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên Nhóm Quyền</th>
                    <th>Chi Tiết Quyền</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody id="roleTbody">
                @if(Model != null)
                {
                    foreach(var r in Model)
                    {
                        var perms = string.IsNullOrEmpty(r.Permissions) ? new string[0] : r.Permissions.Split(',');
                        <tr>
                            <td>#@r.RoleId</td>
                            <td><strong>@r.RoleName</strong></td>
                            <td>
                                @if(perms.Contains("all")) {
                                    <span class="status-badge status-active">Toàn quyền hệ thống</span>
                                } else {
                                    foreach(var p in perms) {
                                        if(string.IsNullOrWhiteSpace(p)) { continue; }
                                        var pName = p;
                                        if (p == "manage_product") { pName = "Quản lý Sản Phẩm"; }
                                        else if (p == "read_product") { pName = "Xem Sản Phẩm"; }
                                        else if (p == "manage_customer") { pName = "Quản lý Khách Hàng"; }
                                        else if (p == "manage_employee") { pName = "Quản lý Nhân Viên"; }
                                        else if (p == "manage_order") { pName = "Quản lý Đơn Hàng"; }
                                        else if (p == "manage_marketing") { pName = "Quản lý Khuyến Mãi"; }
                                        else if (p == "manage_cms") { pName = "Quản lý Nội Dung (Blog/FAQ)"; }
                                        else if (p == "manage_setting") { pName = "Quản lý Cài Đặt"; }
                                        else if (p == "read_report") { pName = "Xem Báo Cáo"; }
                                        <span class="status-badge status-warning me-1 mb-1 d-inline-block">@pName</span>
                                    }
                                }
                            </td>
                            <td>
                                <button class="btn-icon btn-edit" onclick="editRole(@r.RoleId, '@r.RoleName', '@r.Permissions')"><i class="fas fa-edit"></i></button>
                                @if (r.RoleId != 1) {
                                    <button class="btn-icon btn-delete" onclick="deleteRole(@r.RoleId)"><i class="fas fa-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content admin-form">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Nhóm Quyền Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="roleForm">
                    <input type="hidden" id="roleId">
                    <div class="mb-3">
                        <label class="form-label">Tên Nhóm Quyền</label>
                        <input type="text" class="form-control" id="roleName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quyền Hạn (Permissions)</label>
                        <div class="permission-checkboxes">
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="all" id="perm_all">
                                <label class="form-check-label text-white" for="perm_all">Toàn quyền (Admin)</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_product" id="perm_prod">
                                <label class="form-check-label text-white" for="perm_prod">Quản lý Sản Phẩm (Thêm/Sửa/Xóa)</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="read_product" id="perm_read_prod">
                                <label class="form-check-label text-white" for="perm_read_prod">Xem Sản Phẩm</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_customer" id="perm_cust">
                                <label class="form-check-label text-white" for="perm_cust">Quản lý Khách Hàng</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_employee" id="perm_emp">
                                <label class="form-check-label text-white" for="perm_emp">Quản lý Nhân Viên</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_order" id="perm_order">
                                <label class="form-check-label text-white" for="perm_order">Quản lý Đơn Hàng</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_marketing" id="perm_marketing">
                                <label class="form-check-label text-white" for="perm_marketing">Quản lý Khuyến Mãi</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_cms" id="perm_cms">
                                <label class="form-check-label text-white" for="perm_cms">Quản lý Nội Dung (Blog/FAQ)</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="read_report" id="perm_report">
                                <label class="form-check-label text-white" for="perm_report">Xem Báo Cáo</label>
                            </div>
                            <div class="permission-item form-check">
                                <input class="form-check-input perm-cb" type="checkbox" value="manage_setting" id="perm_setting">
                                <label class="form-check-label text-white" for="perm_setting">Quản lý Cài Đặt HT</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-admin" onclick="saveRole()">Lưu Thay Đổi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let roleModal;

        document.addEventListener('DOMContentLoaded', () => {
            roleModal = new bootstrap.Modal(document.getElementById('roleModal'));

            // Handle 'all' checkbox logic
            document.getElementById('perm_all').addEventListener('change', function() {
                const isChecked = this.checked;
                document.querySelectorAll('.perm-cb').forEach(cb => {
                    if (cb.id !== 'perm_all') {
                        cb.checked = isChecked;
                        cb.disabled = isChecked;
                    }
                });
            });
        });

        function openRoleModal() {
            document.getElementById('roleForm').reset();
            document.getElementById('roleId').value = '';
            document.getElementById('modalTitle').textContent = 'Thêm Nhóm Quyền Mới';
            
            document.querySelectorAll('.perm-cb').forEach(cb => {
                cb.disabled = false;
            });
            
            roleModal.show();
        }

        function editRole(id, name, perms) {
            document.getElementById('roleForm').reset();
            document.getElementById('roleId').value = id;
            document.getElementById('roleName').value = name;
            document.getElementById('modalTitle').textContent = 'Cập Nhật Nhóm Quyền';

            document.querySelectorAll('.perm-cb').forEach(cb => {
                cb.disabled = false;
                cb.checked = false;
            });

            if (perms) {
                const pArray = perms.split(',');
                if (pArray.includes('all')) {
                    document.getElementById('perm_all').checked = true;
                    document.getElementById('perm_all').dispatchEvent(new Event('change'));
                } else {
                    pArray.forEach(p => {
                        const cb = document.querySelector(`.perm-cb[value="${p}"]`);
                        if (cb) cb.checked = true;
                    });
                }
            }
            
            roleModal.show();
        }

        function saveRole() {
            const form = document.getElementById('roleForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const id = document.getElementById('roleId').value;
            const name = document.getElementById('roleName').value;
            
            let permissions = [];
            if (document.getElementById('perm_all').checked) {
                permissions.push('all');
            } else {
                document.querySelectorAll('.perm-cb:checked').forEach(cb => {
                    if (cb.id !== 'perm_all') permissions.push(cb.value);
                });
            }

            const formData = new FormData();
            if (id) formData.append('id', id);
            formData.append('name', name);
            formData.append('permissions', permissions.join(','));

            fetch('@Url.Action("SaveRole", "Admin")', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + data.message);
                }
            })
            .catch(err => alert('Lỗi mạng: ' + err));
        }

        function deleteRole(id) {
            if (confirm('Bạn có chắc chắn muốn xóa nhóm quyền này?')) {
                fetch('@Url.Action("DeleteRole", "Admin")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'id=' + id
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) location.reload();
                    else alert('Lỗi: ' + data.message);
                });
            }
        }
    </script>
}


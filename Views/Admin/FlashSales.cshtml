@model IEnumerable<PandoraWeb.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@ViewBag.Title</h1>
    <a href="@Url.Action("CreateFlashSale", "Admin")" class="btn btn-admin">
        <i class="fas fa-plus"></i> Cập Nhật Hàng Loạt
    </a>
</div>

<div class="row">
    <div class="col-12">
        <div class="alert alert-info border-info" style="background-color: rgba(13, 202, 240, 0.1); color: #055160;">
            <i class="fas fa-info-circle me-2"></i> Đây là danh sách các Sản phẩm đang được áp dụng giá Flash Sale (Có giá gốc bị gạch ngang và thời gian chưa hết hạn).
        </div>
    </div>
</div>

<div class="table-wrapper">
    <table class="table admin-table table-hover">
        <thead>
            <tr>
                <th>Sản Phẩm</th>
                <th>Giá Cũ</th>
                <th>Giá Flash Sale</th>
                <th>Giảm (%)</th>
                <th>Thời Gian Kết Thúc</th>
                <th>Tình Trạng</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    decimal percent = 0;
                    if (item.OldPrice.HasValue && item.OldPrice.Value > 0)
                    {
                        percent = Math.Round((1 - (item.BasePrice / item.OldPrice.Value)) * 100);
                    }
                    var rawImg = PandoraWeb.Helpers.ImageHelper.GetImageUrl(item.ImageUrl, "");
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@rawImg" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px; margin-right: 10px;" />
                                <div>
                                    <strong>@item.ProductName</strong>
                                    <div class="text-muted" style="font-size: 0.8rem;">#@item.ProductId</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted text-decoration-line-through">@item.OldPrice.Value.ToString("N0") ₫</td>
                        <td class="text-danger fw-bold">@item.BasePrice.ToString("N0") ₫</td>
                        <td class="text-danger fw-bold fs-5">-@percent%</td>
                        <td>
                            @(item.FlashSaleEndDate.HasValue ? item.FlashSaleEndDate.Value.ToString("dd/MM/yyyy HH:mm") : "Vô hạn")
                        </td>
                        <td>
                            @if(!item.FlashSaleEndDate.HasValue || item.FlashSaleEndDate.Value >= DateTime.Now) {
                                <span class="badge bg-danger pulse-animation">Đang diễn ra</span>
                            } else {
                                <span class="badge bg-secondary">Đã kết thúc</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">Không có sản phẩm Flash Sale nào đang chạy.</td></tr>
            }
        </tbody>
    </table>
</div>

<style>
    .pulse-animation {
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
</style>

@model PandoraWeb.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = $"Chi Tiết Đơn Hàng #PAN{Model.OrderId}";
    var statusClass = "bg-warning text-dark";
    var statusText = Model.OrderStatus ?? "Chờ xử lý";
    
    if (Model.OrderStatus == "Delivered")
    {
        statusClass = "bg-success";
        statusText = "Đã giao";
    }
    else if (Model.OrderStatus == "Shipped")
    {
        statusClass = "bg-primary";
        statusText = "Đang giao";
    }
    else if (Model.OrderStatus == "Cancelled")
    {
        statusClass = "bg-danger";
        statusText = "Đã hủy";
    }
    else if (Model.OrderStatus == "Processing")
    {
        statusClass = "bg-info text-dark";
        statusText = "Đang xử lý";
    }
    
    bool canCancel = (Model.OrderStatus == "Pending" || Model.OrderStatus == "Processing");
}

<div class="breadcrumb-wrap mt-5 pt-5 mb-4 bg-light">
    <div class="container mt-4">
        <h1 class="breadcrumb-title font-serif">Chi Tiết Đơn Hàng</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang Chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Orders", "Order")">Lịch Sử Đơn Hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">#PAN@(Model.OrderId)</li>
            </ol>
        </nav>
    </div>
</div>

<section class="pb-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="font-serif fw-bold mb-0">Đơn hàng <span class="text-primary-gold">#PAN@(Model.OrderId)</span></h4>
            <a href="@Url.Action("Orders", "Order")" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Danh sách sản phẩm -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-box-open text-muted me-2"></i>Sản Phẩm Đã Mua</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Sản phẩm</th>
                                        <th class="text-center">Đơn giá</th>
                                        <th class="text-center">SL</th>
                                        <th class="text-end pe-4">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model.OrderItems)
                                    {
                                        var p = item.Variant?.Product;
                                        var img = p != null && !string.IsNullOrEmpty(p.ImageUrl) ? p.ImageUrl : "https://via.placeholder.com/80";
                                        var name = p != null ? p.ProductName : "Trang sức Pandora";
                                        
                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <img src="@img" class="rounded object-fit-cover me-3" style="width: 60px; height: 60px;" alt="@name">
                                                    <div>
                                                        <h6 class="mb-1 fw-bold fs-7">@name</h6>
                                                        <small class="text-muted">Kích cỡ: @(item.Variant?.Size?.SizeValue ?? "N/A") | Chất liệu: @(item.Variant?.Material?.MaterialName ?? "N/A")</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center">@item.UnitPrice.ToString("N0") ₫</td>
                                            <td class="text-center fw-bold">@item.Quantity</td>
                                            <td class="text-end pe-4 text-primary-gold fw-bold">@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Địa chỉ giao hàng -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-map-marker-alt text-muted me-2"></i>Thông Tin Giao Hàng</h5>
                    </div>
                    <div class="card-body">
                        @if(Model.ShippingAddress != null)
                        {
                            <div class="row">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <p class="mb-1 text-muted fs-7">Người nhận</p>
                                    <p class="mb-0 fw-bold fs-6">@Model.ShippingAddress.ReceiverName</p>
                                    <p class="mb-0"><i class="fas fa-phone-alt fs-8 text-muted me-1"></i>@Model.ShippingAddress.PhoneNumber</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1 text-muted fs-7">Địa chỉ nhận hàng</p>
                                    <p class="mb-0 fw-bold">@Model.ShippingAddress.StreetAddress</p>
                                    <p class="mb-0 text-muted fs-7">@Model.ShippingAddress.Ward, @Model.ShippingAddress.District, @Model.ShippingAddress.City</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted fst-italic">Không có thông tin địa chỉ.</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Tổng kết đơn hàng -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-receipt text-muted me-2"></i>Tóm Tắt Đơn Hàng</h5>
                    </div>
                    <div class="card-body bg-light">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Trạng thái:</span>
                            <span class="badge @statusClass fs-7">@statusText</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Ngày đặt:</span>
                            <span class="fw-semibold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Thanh toán:</span>
                            <span class="fw-semibold">@Model.PaymentMethod</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span>@((Model.TotalAmount + Model.DiscountAmount - Model.ShippingFee).ToString("N0")) ₫</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span>@(Model.ShippingFee > 0 ? Model.ShippingFee.ToString("N0") + " ₫" : "Miễn phí")</span>
                        </div>
                        @if(Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá:</span>
                                <span>-@Model.DiscountAmount.ToString("N0") ₫</span>
                            </div>
                        }
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Tổng cộng:</span>
                            <span class="fw-bold fs-4 text-primary-gold">@Model.TotalAmount.ToString("N0") ₫</span>
                        </div>
                        
                        @if (canCancel)
                        {
                            <button class="btn btn-outline-danger w-100 mt-4 py-2" onclick="cancelOrder(@Model.OrderId)">
                                <i class="fas fa-times-circle me-1"></i> Hủy Đơn Hàng Này
                            </button>
                            <small class="d-block text-center text-muted mt-2 fs-8">Chỉ có thể hủy khi đơn hàng chưa được xử lý giao.</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function cancelOrder(id) {
            if(confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Quá trình này không thể hoàn tác.')) {
                fetch('@Url.Action("CancelOrder", "Order")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ id: id })
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        alert(data.message || 'Đã hủy đơn hàng thành công!');
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra khi hủy đơn!');
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Lỗi kết nối máy chủ!');
                });
            }
        }
    </script>
}

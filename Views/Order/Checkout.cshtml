@model List<PandoraWeb.ViewModels.CartItemVM>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Thanh Toán - Pandora";
    decimal subTotal = Model != null ? Model.Sum(x => x.Total) : 0;
    
    var customer = ViewBag.Customer as PandoraWeb.Models.Customer;
    var address = ViewBag.Address as PandoraWeb.Models.Address;
    
    string nameVal = customer != null ? customer.FullName : "";
    string phoneVal = customer != null ? customer.PhoneNumber : "";
    string emailVal = customer != null ? customer.Email : "";

    string cityVal = address != null && !string.IsNullOrEmpty(address.City) && address.City != "Thành phố" ? address.City : "";
    string distVal = address != null && !string.IsNullOrEmpty(address.District) && address.District != "Quận/Huyện" ? address.District : "";
    string wardVal = address != null && !string.IsNullOrEmpty(address.Ward) && address.Ward != "Phường/Xã" ? address.Ward : "";
    string streetVal = address != null ? address.StreetAddress : "";

    if (streetVal.Contains(",") && string.IsNullOrEmpty(cityVal))
    {
        var parts = streetVal.Split(',');
        if (parts.Length >= 4)
        {
            streetVal = parts[0].Trim();
            wardVal = parts[1].Trim();
            distVal = parts[2].Trim();
            cityVal = parts[3].Trim();
        }
    }
    string addrVal = address != null ? $"{streetVal}, {wardVal}, {distVal}, {cityVal}".Trim(new char[] { ',', ' ' }) : "";
}

<div class="container mt-5 pt-4 pb-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (customer == null)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4 p-3 rounded" style="background-color: #f0f7ff;">
            <i class="fas fa-user-clock text-primary fs-3 me-3"></i>
            <div class="flex-grow-1">
                <strong class="d-block text-dark">Đặt hàng nhanh không cần đăng nhập (Khách vãng lai)</strong>
                <small class="text-muted">Bạn có thể nhập thông tin để chốt đơn ngay. Hoặc <a href="@Url.Action("Login", "Account")" class="fw-bold text-primary text-decoration-none">Đăng nhập ngay</a> để tích điểm thành viên và quản lý đơn hàng tốt hơn.</small>
            </div>
        </div>
    }

    <div class="row">
        <!-- Checkout Form -->
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="font-serif mb-4 pb-2 border-bottom"><i class="fas fa-shipping-fast text-primary-gold me-2"></i>1. Thông tin giao hàng</h4>
                <form class="checkout-form" id="form-checkout" action="@Url.Action("Checkout", "Order")" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold fs-7">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control py-2" name="fullName" value="@nameVal" placeholder="Nhập họ và tên người nhận" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold fs-7">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control py-2" name="phone" value="@phoneVal" placeholder="Nhập số điện thoại" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold fs-7">Địa chỉ email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control py-2" name="email" value="@emailVal" placeholder="Nhập địa chỉ email nhận thông tin đơn hàng" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold fs-7">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                            <select class="form-select py-2" id="citySelect" name="city" required>
                                <option value="">-- Chọn Tỉnh / Thành phố --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold fs-7">Quận / Huyện <span class="text-danger">*</span></label>
                            <select class="form-select py-2" id="districtSelect" name="district" required disabled>
                                <option value="">-- Chọn Quận / Huyện --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold fs-7">Phường / Xã / Thị trấn <span class="text-danger">*</span></label>
                            <select class="form-select py-2" id="wardSelect" name="ward" required disabled>
                                <option value="">-- Chọn Phường / Xã / Thị trấn --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold fs-7">Địa chỉ cụ thể (Số nhà, Tên đường, Thôn / Ấp / Xóm) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control py-2" id="streetInput" name="street" value="@streetVal" placeholder="VD: Số 123 Đường Nguyễn Huệ, Thôn 1..." required minlength="4">
                            <input type="hidden" name="address" id="fullAddressInput" value="@addrVal">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold fs-7">Ghi chú đơn hàng (Tùy chọn)</label>
                            <textarea class="form-control" name="notes" rows="3" placeholder="Lời nhắn cho cửa hàng hoặc chỉ dẫn giao hàng..."></textarea>
                        </div>
                    </div>

                    <h4 class="font-serif mb-4 mt-5 pb-2 border-bottom"><i class="fas fa-credit-card text-primary-gold me-2"></i>2. Phương thức thanh toán</h4>
                    <div class="form-check mb-3 p-3 border rounded shadow-sm hover-shadow transition">
                        <input class="form-check-input ms-1 mt-2" type="radio" name="paymentMethod" value="COD" id="cod" checked>
                        <label class="form-check-label ms-3 d-flex align-items-center w-100 cursor-pointer" for="cod">
                            <i class="fas fa-money-bill-wave text-success fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Thanh toán khi nhận hàng (COD)</h6>
                                <small class="text-muted">Thanh toán bằng tiền mặt trực tiếp cho nhân viên giao hàng.</small>
                            </div>
                        </label>
                    </div>
                    <div class="form-check mb-3 p-3 border rounded shadow-sm hover-shadow transition">
                        <input class="form-check-input ms-1 mt-2" type="radio" name="paymentMethod" value="BANK" id="bank">
                        <label class="form-check-label ms-3 d-flex align-items-center w-100 cursor-pointer" for="bank">
                            <i class="fas fa-university text-primary fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Chuyển khoản ngân hàng (NAPAS 247 / QR Code)</h6>
                                <small class="text-muted">Chuyển khoản qua mã QR ngân hàng tiện lợi & nhanh chóng.</small>
                            </div>
                        </label>
                    </div>
                </form>
            </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 sticky-top" style="top: 100px;">
                <h5 class="font-serif mb-4 pb-2 border-bottom">Đơn Hàng Của Bạn (@(Model != null ? Model.Count : 0) sản phẩm)</h5>
                
                <!-- Order Items Mini -->
                <div class="mb-4" style="max-height: 280px; overflow-y: auto;">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string imgSrc = PandoraWeb.Helpers.ImageHelper.GetImageUrl(item.ImageUrl, "https://images.unsplash.com/photo-1605100804763-247f67b2548e?q=80&w=80");
                            <div class="d-flex align-items-center mb-3">
                                <img src="@imgSrc" class="rounded object-fit-cover" style="width: 55px; height: 55px;" alt="@item.ProductName" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1605100804763-247f67b2548e?q=80&w=80';">
                                <div class="ms-3 flex-grow-1">
                                    <h6 class="mb-0 fs-7 text-truncate font-serif" style="max-width: 150px;" title="@item.ProductName">@item.ProductName</h6>
                                    @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Material))
                                    {
                                        <small class="text-muted fs-8 d-block">
                                            @(!string.IsNullOrEmpty(item.Size) ? "Size: " + item.Size : "")
                                            @(!string.IsNullOrEmpty(item.Material) ? " | " + item.Material : "")
                                        </small>
                                    }
                                    <span class="text-muted fs-8">SL: @item.Quantity</span>
                                </div>
                                <div class="text-end ms-2">
                                    <strong class="fs-7 text-dark">@item.Total.ToString("N0") ₫</strong>
                                </div>
                            </div>
                        }
                    }
                </div>
                
                <hr>

                <div class="d-flex justify-content-between mb-2 fs-7">
                    <span class="text-muted">Tạm tính</span>
                    <span class="fw-bold">@subTotal.ToString("N0") ₫</span>
                </div>
                <div class="d-flex justify-content-between mb-2 fs-7">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span class="text-success fw-bold">Miễn phí</span>
                </div>
                <div class="d-flex justify-content-between mb-2 fs-7">
                    <span class="text-muted">Giảm giá</span>
                    <span class="text-danger">-0 ₫</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-4">
                    <strong class="fs-5">Tổng thanh toán</strong>
                    <strong class="fs-5 text-primary-gold">@subTotal.ToString("N0") ₫</strong>
                </div>

                <button type="submit" form="form-checkout" class="btn btn-gold w-100 py-3 mb-3 fw-bold tracking-wider fs-6 shadow-sm">
                    <i class="fas fa-check-circle me-2"></i>ĐẶT HÀNG NGAY
                </button>
                <p class="text-center text-muted fs-8 mb-0">Bằng việc nhấn đặt hàng, bạn đồng ý với <a href="#" class="text-dark">Điều khoản & Điều kiện</a> dịch vụ Pandora.</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var citySelect = document.getElementById('citySelect');
        var districtSelect = document.getElementById('districtSelect');
        var wardSelect = document.getElementById('wardSelect');

        var savedCity = "@Html.Raw(cityVal)";
        var savedDist = "@Html.Raw(distVal)";
        var savedWard = "@Html.Raw(wardVal)";

        // 1. Load 63 Tỉnh / Thành phố Việt Nam
        fetch('https://esgoo.net/api-tinhthanh/1/0.htm')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.error === 0) {
                    data.data.forEach(function(item) {
                        var opt = document.createElement('option');
                        opt.value = item.full_name;
                        opt.setAttribute('data-id', item.id);
                        opt.textContent = item.full_name;
                        if (savedCity && (item.full_name.includes(savedCity) || savedCity.includes(item.name))) {
                            opt.selected = true;
                        }
                        citySelect.appendChild(opt);
                    });

                    if (citySelect.value) {
                        var selectedOpt = citySelect.options[citySelect.selectedIndex];
                        if (selectedOpt && selectedOpt.getAttribute('data-id')) {
                            loadDistricts(selectedOpt.getAttribute('data-id'));
                        }
                    }
                }
            })
            .catch(function(err) {
                console.warn('API Tỉnh thành error:', err);
            });

        // 2. Chọn Tỉnh/Thành -> Load Quận/Huyện
        if (citySelect) {
            citySelect.addEventListener('change', function() {
                var selectedOpt = citySelect.options[citySelect.selectedIndex];
                var provinceId = selectedOpt ? selectedOpt.getAttribute('data-id') : null;

                districtSelect.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
                wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã / Thị trấn --</option>';
                wardSelect.disabled = true;

                if (provinceId) {
                    loadDistricts(provinceId);
                } else {
                    districtSelect.disabled = true;
                }
            });
        }

        function loadDistricts(provinceId) {
            districtSelect.disabled = false;
            districtSelect.innerHTML = '<option value="">-- Đang tải Quận / Huyện... --</option>';

            fetch('https://esgoo.net/api-tinhthanh/2/' + provinceId + '.htm')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    districtSelect.innerHTML = '<option value="">-- Chọn Quận / Huyện --</option>';
                    if (data.error === 0) {
                        data.data.forEach(function(item) {
                            var opt = document.createElement('option');
                            opt.value = item.full_name;
                            opt.setAttribute('data-id', item.id);
                            opt.textContent = item.full_name;
                            if (savedDist && (item.full_name.includes(savedDist) || savedDist.includes(item.name))) {
                                opt.selected = true;
                            }
                            districtSelect.appendChild(opt);
                        });

                        if (districtSelect.value) {
                            var selectedOpt = districtSelect.options[districtSelect.selectedIndex];
                            if (selectedOpt && selectedOpt.getAttribute('data-id')) {
                                loadWards(selectedOpt.getAttribute('data-id'));
                            }
                        }
                    }
                });
        }

        // 3. Chọn Quận/Huyện -> Load Phường/Xã
        if (districtSelect) {
            districtSelect.addEventListener('change', function() {
                var selectedOpt = districtSelect.options[districtSelect.selectedIndex];
                var districtId = selectedOpt ? selectedOpt.getAttribute('data-id') : null;

                wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã / Thị trấn --</option>';

                if (districtId) {
                    loadWards(districtId);
                } else {
                    wardSelect.disabled = true;
                }
            });
        }

        function loadWards(districtId) {
            wardSelect.disabled = false;
            wardSelect.innerHTML = '<option value="">-- Đang tải Phường / Xã... --</option>';

            fetch('https://esgoo.net/api-tinhthanh/3/' + districtId + '.htm')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã / Thị trấn --</option>';
                    if (data.error === 0) {
                        data.data.forEach(function(item) {
                            var opt = document.createElement('option');
                            opt.value = item.full_name;
                            opt.setAttribute('data-id', item.id);
                            opt.textContent = item.full_name;
                            if (savedWard && (item.full_name.includes(savedWard) || savedWard.includes(item.name))) {
                                opt.selected = true;
                            }
                            wardSelect.appendChild(opt);
                        });
                    }
                });
        }

        // 4. Form Submit: Ghép chuỗi địa chỉ đầy đủ
        var form = document.getElementById('form-checkout');
        if (form) {
            form.addEventListener('submit', function(e) {
                var city = (citySelect ? citySelect.value : '').trim();
                var dist = (districtSelect ? districtSelect.value : '').trim();
                var ward = (wardSelect ? wardSelect.value : '').trim();
                var street = (document.getElementById('streetInput') ? document.getElementById('streetInput').value : '').trim();

                if (!city || !dist || !ward || street.length < 3) {
                    e.preventDefault();
                    alert('Vui lòng chọn đầy đủ Tỉnh/Thành phố, Quận/Huyện, Phường/Xã/Ấp và nhập Địa chỉ cụ thể.');
                    return false;
                }

                var fullAddr = street + ', ' + ward + ', ' + dist + ', ' + city;
                var hiddenInput = document.getElementById('fullAddressInput');
                if (hiddenInput) {
                    hiddenInput.value = fullAddr;
                }
            });
        }
    });
</script>


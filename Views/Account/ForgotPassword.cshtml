@{
    Layout = null;
    ViewBag.Title = "Quên Mật Khẩu - Pandora";
    bool accountFound = ViewBag.AccountFound != null && (bool)ViewBag.AccountFound;
    string loginId = ViewBag.LoginId?.ToString() ?? "";
    string accountName = ViewBag.AccountName?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên Mật Khẩu - Pandora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/global.css">
    <link rel="stylesheet" href="~/assets/css/components/buttons.css">
    <link rel="stylesheet" href="~/assets/css/components/forms.css">
    <link rel="stylesheet" href="~/assets/css/auth.css?v=2">
</head>
<body>

    <div class="auth-container">
        <div class="auth-overlay"></div>
        <div class="auth-card">
            <div class="text-center mb-4">
                <a href="@Url.Action("Index", "Home")" class="auth-brand m-0">PANDORA</a>
                <p class="auth-subtitle mt-2">Khôi phục mật khẩu tài khoản</p>
            </div>
            
            <form method="post" action="@Url.Action("ForgotPassword", "Account")">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                    </div>
                }
                
                @if (!accountFound)
                {
                    <div class="mb-4">
                        <label class="form-label">Email hoặc Số điện thoại</label>
                        <input type="text" name="loginId" value="@loginId" class="form-control py-2" placeholder="Nhập email hoặc SĐT đã đăng ký" required autofocus>
                        <small class="text-muted mt-1 d-block fs-7">Hệ thống sẽ tìm kiếm tài khoản Pandora của bạn để tiến hành đặt lại mật khẩu.</small>
                    </div>
                    
                    <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                        <i class="fas fa-search me-2"></i>Tìm Tài Khoản
                    </button>
                }
                else
                {
                    <div class="alert alert-info py-2 mb-3">
                        <i class="fas fa-user-check me-2"></i>Tài khoản: <strong>@accountName</strong> (@loginId)
                    </div>
                    <input type="hidden" name="loginId" value="@loginId" />
                    
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <input type="password" name="newPassword" class="form-control py-2" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" minlength="6" required autofocus>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <input type="password" name="confirmPassword" class="form-control py-2" placeholder="Nhập lại mật khẩu mới" minlength="6" required>
                    </div>
                    
                    <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                        <i class="fas fa-key me-2"></i>Đặt Lại Mật Khẩu
                    </button>
                }
                
                <div class="text-center mt-3 d-flex justify-content-between fs-7">
                    <a href="@Url.Action("Login", "Account")" class="text-primary-gold text-decoration-none fw-bold">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                    <a href="@Url.Action("Signup", "Account")" class="text-muted text-decoration-none">
                        Tạo tài khoản mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

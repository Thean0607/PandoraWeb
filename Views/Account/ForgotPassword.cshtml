@{
    Layout = null;
    ViewBag.Title = "Quên Mật Khẩu - Pandora";
    int step = ViewBag.Step != null ? (int)ViewBag.Step : 1;
    string loginId = ViewBag.LoginId?.ToString() ?? "";
    string email = ViewBag.Email?.ToString() ?? "";
    string accountName = ViewBag.AccountName?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên Mật Khẩu - Pandora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/global.css">
    <link rel="stylesheet" href="~/assets/css/components/buttons.css">
    <link rel="stylesheet" href="~/assets/css/components/forms.css">
    <link rel="stylesheet" href="~/assets/css/auth.css?v=2">
</head>
<body>

    <div class="auth-container">
        <div class="auth-overlay"></div>
        <div class="auth-card">
            <div class="text-center mb-4">
                <a href="@Url.Action("Index", "Home")" class="auth-brand m-0">PANDORA</a>
                <p class="auth-subtitle mt-2">Khôi phục mật khẩu qua Mã OTP</p>
            </div>
            
            <!-- Step Progress Indicator -->
            <div class="d-flex justify-content-center align-items-center mb-4 px-2">
                <div class="text-center position-relative">
                    <span class="badge rounded-circle @(step >= 1 ? "bg-warning text-dark" : "bg-secondary")" style="width:28px; height:28px; line-height:20px;">1</span>
                    <small class="d-block mt-1 fs-8 fw-bold @(step >= 1 ? "text-warning" : "text-muted")">Nhập Email</small>
                </div>
                <div class="flex-grow-1 mx-2 mb-3 border-top @(step >= 2 ? "border-warning" : "border-secondary")" style="border-width: 2px !important;"></div>
                <div class="text-center position-relative">
                    <span class="badge rounded-circle @(step >= 2 ? "bg-warning text-dark" : "bg-secondary")" style="width:28px; height:28px; line-height:20px;">2</span>
                    <small class="d-block mt-1 fs-8 fw-bold @(step >= 2 ? "text-warning" : "text-muted")">Xác thực OTP</small>
                </div>
                <div class="flex-grow-1 mx-2 mb-3 border-top @(step >= 3 ? "border-warning" : "border-secondary")" style="border-width: 2px !important;"></div>
                <div class="text-center position-relative">
                    <span class="badge rounded-circle @(step >= 3 ? "bg-warning text-dark" : "bg-secondary")" style="width:28px; height:28px; line-height:20px;">3</span>
                    <small class="d-block mt-1 fs-8 fw-bold @(step >= 3 ? "text-warning" : "text-muted")">Mật khẩu mới</small>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                </div>
            }
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success py-2 mb-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@ViewBag.SuccessMessage
                </div>
            }

            @if (step == 1)
            {
                <!-- STEP 1: Enter Email / Phone -->
                <form method="post" action="@Url.Action("ForgotPassword", "Account")">
                    <input type="hidden" name="actionStep" value="send_otp" />
                    <div class="mb-4">
                        <label class="form-label fw-bold">Email hoặc Số điện thoại tài khoản</label>
                        <input type="text" name="loginId" value="@loginId" class="form-control py-2" placeholder="Nhập email hoặc SĐT đã đăng ký" required autofocus>
                        <small class="text-muted mt-1 d-block fs-7">Hệ thống sẽ gửi mã xác thực OTP 6 số về Email của tài khoản này.</small>
                    </div>
                    
                    <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                        <i class="fas fa-paper-plane me-2"></i>Gửi Mã OTP Xác Thực
                    </button>
                </form>
            }
            else if (step == 2)
            {
                <!-- STEP 2: Verify 6-digit OTP -->
                <form method="post" action="@Url.Action("ForgotPassword", "Account")">
                    <input type="hidden" name="actionStep" value="verify_otp" />
                    <div class="alert alert-info py-2 mb-3 fs-7">
                        <i class="fas fa-envelope-open-text me-2"></i>Mã OTP đã được gửi đến: <strong>@email</strong>
                    </div>

                    <div class="mb-4 text-center">
                        <label class="form-label fw-bold d-block text-start">Nhập mã OTP 6 số</label>
                        <input type="text" name="otpCode" class="form-control text-center py-2 fs-4 tracking-widest fw-bold text-warning bg-dark border-warning" placeholder="• • • • • •" maxlength="6" pattern="[0-9]{6}" required autofocus style="letter-spacing: 12px;">
                        <small class="text-muted mt-2 d-block fs-7"><i class="far fa-clock me-1"></i>Mã OTP có hiệu lực trong vòng 10 phút.</small>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                        <i class="fas fa-shield-alt me-2"></i>Xác Thực Mã OTP
                    </button>
                </form>

                <form method="post" action="@Url.Action("ForgotPassword", "Account")" class="text-center">
                    <input type="hidden" name="actionStep" value="send_otp" />
                    <input type="hidden" name="loginId" value="@email" />
                    <button type="submit" class="btn btn-link text-muted text-decoration-none fs-7 p-0">
                        <i class="fas fa-redo me-1"></i>Chưa nhận được mã? Gửi lại OTP
                    </button>
                </form>
            }
            else if (step == 3)
            {
                <!-- STEP 3: Set New Password -->
                <form method="post" action="@Url.Action("ForgotPassword", "Account")">
                    <input type="hidden" name="actionStep" value="reset_password" />
                    <div class="alert alert-success py-2 mb-3 fs-7">
                        <i class="fas fa-user-check me-2"></i>Đã xác thực tài khoản: <strong>@accountName</strong> (@email)
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu mới</label>
                        <input type="password" name="newPassword" class="form-control py-2" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" minlength="6" required autofocus>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                        <input type="password" name="confirmPassword" class="form-control py-2" placeholder="Nhập lại mật khẩu mới" minlength="6" required>
                    </div>

                    <button type="submit" class="btn btn-gold w-100 py-2 mb-3">
                        <i class="fas fa-key me-2"></i>Lưu Mật Khẩu Mới
                    </button>
                </form>
            }

            <div class="text-center mt-3 d-flex justify-content-between fs-7 border-top pt-3">
                <a href="@Url.Action("ForgotPassword", "Account", new { step = 1 })" class="text-muted text-decoration-none">
                    <i class="fas fa-redo me-1"></i>Nhập lại Email
                </a>
                <a href="@Url.Action("Login", "Account")" class="text-primary-gold text-decoration-none fw-bold">
                    Quay lại Đăng nhập<i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

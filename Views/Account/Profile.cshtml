@model PandoraWeb.Models.Customer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Hồ Sơ Của Tôi - Pandora";
    string custName = Model != null ? Model.FullName : (Session["FullName"]?.ToString() ?? "Khách hàng");
    string defaultAvatar = "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=200&auto=format&fit=crop";
    string currentAvatar = Model != null && !string.IsNullOrEmpty(Model.AvatarUrl) 
        ? PandoraWeb.Helpers.ImageHelper.GetImageUrl(Model.AvatarUrl, defaultAvatar) 
        : defaultAvatar;
}

<!-- Breadcrumb -->
<div class="breadcrumb-wrap mt-5 pt-5 mb-4">
    <div class="container mt-4">
        <h1 class="breadcrumb-title font-serif">Tài Khoản</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang Chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ Sơ Của Tôi</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Profile Section -->
<section class="pb-5">
    <div class="container">
        <div class="row">
            <!-- Filter Toggle Button (Mobile Only) -->
            <div class="d-lg-none mb-4">
                <button class="btn btn-outline-gold w-100" type="button" data-bs-toggle="offcanvas" data-bs-target="#profileSidebar" aria-controls="profileSidebar">
                    <i class="fas fa-bars me-2"></i> Menu Tài Khoản
                </button>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-3 mb-4 mb-lg-0">
                <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="profileSidebar" aria-labelledby="profileSidebarLabel">
                    <div class="offcanvas-header border-bottom">
                        <h5 class="offcanvas-title font-serif" id="profileSidebarLabel">Menu Tài Khoản</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#profileSidebar" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body p-3 p-lg-0 flex-column">
                        <div class="card border-0 shadow-sm p-3 w-100">
                            <div class="text-center mb-4 mt-3 d-none d-lg-block">
                                <div class="avatar-wrapper mx-auto mb-3" style="width: 80px; height: 80px;">
                                    <img src="@currentAvatar" alt="Avatar" class="avatar-img-preview rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.onerror=null; this.src='@defaultAvatar';">
                                </div>
                                <h5 class="font-serif fw-bold mb-1">@custName</h5>
                                <p class="text-muted fs-7 mb-0">Thành viên Pandora</p>
                            </div>
                            <hr class="mt-0 mb-3 text-muted d-none d-lg-block">
                            <nav class="nav flex-column profile-sidebar">
                                <a class="nav-link active" href="@Url.Action("Profile", "Account")"><i class="far fa-user me-2"></i> Thông tin tài khoản</a>
                                <a class="nav-link" href="@Url.Action("Orders", "Order")"><i class="fas fa-shopping-basket me-2"></i> Quản lý đơn hàng</a>
                                <a class="nav-link" href="@Url.Action("Index", "Wishlist")"><i class="far fa-heart me-2"></i> Sản phẩm yêu thích</a>
                                <a class="nav-link" href="@Url.Action("Address", "Account")"><i class="far fa-address-book me-2"></i> Sổ địa chỉ</a>
                                <a class="nav-link" href="@Url.Action("ChangePassword", "Account")"><i class="fas fa-lock me-2"></i> Đổi mật khẩu</a>
                                <a class="nav-link text-danger mt-3" href="@Url.Action("Logout", "Account")"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <h4 class="font-serif mb-0">Hồ Sơ Của Tôi</h4>
                    </div>

                    <div id="avatarAlert" class="alert alert-success alert-dismissible fade show mb-4 d-none" role="alert">
                        <i class="fas fa-check-circle me-2"></i><span id="avatarAlertMsg">Đã cập nhật ảnh đại diện thành công!</span>
                        <button type="button" class="btn-close" onclick="this.parentElement.classList.add('d-none')"></button>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Tabs Navigation -->
                    <ul class="nav nav-tabs mb-4 border-bottom" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-dark" id="view-tab" data-bs-toggle="tab" data-bs-target="#view-mode" type="button" role="tab" aria-controls="view-mode" aria-selected="true">
                                <i class="far fa-id-card me-2 text-primary-gold"></i>Xem Thông Tin
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-dark" id="edit-tab" data-bs-toggle="tab" data-bs-target="#edit-mode" type="button" role="tab" aria-controls="edit-mode" aria-selected="false">
                                <i class="fas fa-user-edit me-2 text-primary-gold"></i>Chỉnh Sửa Hồ Sơ
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="profileTabContent">
                        <!-- TAB 1: VIEW MODE -->
                        <div class="tab-pane fade show active" id="view-mode" role="tabpanel" aria-labelledby="view-tab">
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle">
                                            <tbody>
                                                <tr>
                                                    <td class="text-muted fw-bold py-3" style="width: 140px;">Họ và Tên:</td>
                                                    <td class="fw-bold fs-6 text-dark py-3">@(Model != null ? Model.FullName : "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted fw-bold py-3">Địa chỉ Email:</td>
                                                    <td class="py-3">@(Model != null ? Model.Email : "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted fw-bold py-3">Số điện thoại:</td>
                                                    <td class="py-3">@(!string.IsNullOrEmpty(Model?.PhoneNumber) ? Model.PhoneNumber : "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted fw-bold py-3">Giới tính:</td>
                                                    <td class="py-3">
                                                        @{
                                                            string gen = Model != null ? (Model.Gender ?? "").ToLower() : "";
                                                            string genStr = gen == "female" ? "Nữ" : (gen == "male" ? "Nam" : (gen == "other" ? "Khác" : "Chưa cập nhật"));
                                                        }
                                                        @genStr
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted fw-bold py-3">Ngày sinh:</td>
                                                    <td class="py-3">@(Model != null && Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted fw-bold py-3">Ngày tham gia:</td>
                                                    <td class="py-3">@(Model != null ? Model.CreatedAt.ToString("dd/MM/yyyy") : DateTime.Now.ToString("dd/MM/yyyy"))</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="mt-3">
                                        <button type="button" class="btn btn-gold px-4 py-2 fw-bold" onclick="document.getElementById('edit-tab').click()">
                                            <i class="fas fa-edit me-2"></i>Chỉnh sửa
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-4 d-flex flex-column align-items-center justify-content-start border-start-md pt-3">
                                    <div class="avatar-wrapper mb-3">
                                        <img src="@currentAvatar" alt="Avatar" class="avatar-img-preview" onerror="this.onerror=null; this.src='@defaultAvatar';">
                                    </div>
                                    <div class="text-center text-muted fs-7">
                                        <p class="mb-1 fw-bold text-dark">@custName</p>
                                        <p class="mb-0">Thành viên Pandora</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TAB 2: EDIT MODE -->
                        <div class="tab-pane fade" id="edit-mode" role="tabpanel" aria-labelledby="edit-tab">
                            <form action="@Url.Action("Profile", "Account")" method="post" enctype="multipart/form-data" id="profileEditForm">
                                <div class="row">
                                    <div class="col-md-8 order-2 order-md-1">
                                        <div class="row mb-3">
                                            <div class="col-sm-3 d-flex align-items-center">
                                                <label class="form-label mb-0 fw-bold">Họ và Tên <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control py-2" name="fullName" value="@(Model != null ? Model.FullName : "")" required>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-3 d-flex align-items-center">
                                                <label class="form-label mb-0 fw-bold">Email <span class="text-danger">*</span></label>
                                            </div>
                                            <div class="col-sm-9">
                                                <input type="email" class="form-control py-2" name="email" value="@(Model != null ? Model.Email : "")" required placeholder="Nhập địa chỉ email">
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-3 d-flex align-items-center">
                                                <label class="form-label mb-0 fw-bold">Số điện thoại</label>
                                            </div>
                                            <div class="col-sm-9">
                                                <input type="tel" class="form-control py-2" name="phoneNumber" value="@(Model != null ? Model.PhoneNumber : "")" placeholder="Nhập số điện thoại">
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-sm-3 d-flex align-items-center">
                                                <label class="form-label mb-0 fw-bold">Giới tính</label>
                                            </div>
                                            <div class="col-sm-9 d-flex align-items-center">
                                                @{
                                                    string g = Model != null ? (Model.Gender ?? "").ToLower() : "";
                                                }
                                                <div class="form-check form-check-inline me-4">
                                                    <input class="form-check-input" type="radio" name="gender" id="male" value="Male" @(g == "male" || string.IsNullOrEmpty(g) ? "checked" : "")>
                                                    <label class="form-check-label" for="male">Nam</label>
                                                </div>
                                                <div class="form-check form-check-inline me-4">
                                                    <input class="form-check-input" type="radio" name="gender" id="female" value="Female" @(g == "female" ? "checked" : "")>
                                                    <label class="form-check-label" for="female">Nữ</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="gender" id="other" value="Other" @(g == "other" ? "checked" : "")>
                                                    <label class="form-check-label" for="other">Khác</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-4">
                                            <div class="col-sm-3 d-flex align-items-center">
                                                <label class="form-label mb-0 fw-bold">Ngày sinh</label>
                                            </div>
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control py-2 flatpickr-date" name="dateOfBirth" value="@(Model != null && Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" placeholder="Chọn ngày sinh">
                                            </div>
                                        </div>
                                        
                                        <div class="row">
                                            <div class="col-sm-3"></div>
                                            <div class="col-sm-9 d-flex gap-2">
                                                <button type="submit" class="btn btn-gold px-4 py-2 fw-bold">
                                                    <i class="fas fa-save me-2"></i>Lưu Thay Đổi
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary px-4 py-2" onclick="document.getElementById('view-tab').click()">
                                                    Hủy Bỏ
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Avatar Column -->
                                    <div class="col-md-4 order-1 order-md-2 mb-4 mb-md-0 d-flex flex-column align-items-center justify-content-start border-start-md pt-3">
                                        <div class="avatar-wrapper mb-3">
                                            <img src="@currentAvatar" alt="Avatar" class="avatar-img-preview" onerror="this.onerror=null; this.src='@defaultAvatar';">
                                            <label class="avatar-edit-btn" for="uploadAvatar" title="Đổi ảnh đại diện">
                                                <i class="fas fa-camera"></i>
                                            </label>
                                            <input type="file" id="uploadAvatar" name="avatarFile" class="d-none" accept="image/*, .jpg, .jpeg, .png, .gif, .webp, .svg, .bmp, .heic, *">
                                        </div>
                                        <div class="text-center text-muted fs-7">
                                            <p class="mb-1">Tự động lưu khi chọn ảnh</p>
                                            <p class="mb-0">Kích thước khuyến nghị: 256x256px (Tỉ lệ 1:1) - Tối đa: 2MB</p>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">
    <style>
        /* Tùy chỉnh màu chủ đạo của Datepicker để phù hợp với Pandora (vàng kim) */
        .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange, .flatpickr-day.selected.inRange, .flatpickr-day.startRange.inRange, .flatpickr-day.endRange.inRange, .flatpickr-day.selected:focus, .flatpickr-day.startRange:focus, .flatpickr-day.endRange:focus, .flatpickr-day.selected:hover, .flatpickr-day.startRange:hover, .flatpickr-day.endRange:hover, .flatpickr-day.selected.prevMonthDay, .flatpickr-day.startRange.prevMonthDay, .flatpickr-day.endRange.prevMonthDay, .flatpickr-day.selected.nextMonthDay, .flatpickr-day.startRange.nextMonthDay, .flatpickr-day.endRange.nextMonthDay {
            background: #d4af37 !important;
            border-color: #d4af37 !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            flatpickr(".flatpickr-date", {
                locale: "vn",
                dateFormat: "Y-m-d",
                maxDate: "today",
                altInput: true,
                altFormat: "d/m/Y",
                disableMobile: "true"
            });

            const uploadInput = document.getElementById('uploadAvatar');
            if (uploadInput) {
                uploadInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (!file) return;

                    // Show instant local preview
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        document.querySelectorAll('.avatar-img-preview').forEach(img => {
                            img.src = evt.target.result;
                        });
                    };
                    reader.readAsDataURL(file);

                    // Send AJAX upload request
                    const formData = new FormData();
                    formData.append('avatarFile', file);

                    fetch('@Url.Action("UploadAvatar", "Account")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            document.querySelectorAll('.avatar-img-preview').forEach(img => {
                                img.src = data.avatarUrl;
                            });
                            const alertBox = document.getElementById('avatarAlert');
                            const alertMsg = document.getElementById('avatarAlertMsg');
                            if (alertBox && alertMsg) {
                                alertMsg.textContent = data.message || 'Đã cập nhật ảnh đại diện thành công!';
                                alertBox.classList.remove('d-none');
                            }
                        } else {
                            alert(data.message || 'Có lỗi xảy ra khi tải ảnh đại diện lên!');
                        }
                    })
                    .catch(err => console.error('Upload avatar error:', err));
                });
            }
        });
    </script>
}
